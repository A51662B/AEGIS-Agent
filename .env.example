# ===== 必填 =====

# 模型接口（OpenAI 兼容格式）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== 可选 =====

# 模型名：不填则回落到默认值
CHAT_MODEL=deepseek-flash
REPORT_MODEL=
TITLE_MODEL=

# 上下文窗口大小（token），影响用量面板的占比显示
CONTEXT_WINDOW=128000

# 联网搜索（Tavily）：https://tavily.com
TAVILY_API_KEY=

# PDF 解析（MinerU Standard API）：https://mineru.net
MINERU_API_TOKEN=
# ===== 可选：接入外部 MCP 工具服务 =====

# mcp_server.py 的绝对路径；不填则不加载任何外部工具
# 例：D:/path/to/my-ragflow/mcp_server.py
MCP_SERVER_PATH=
# 服务端工作目录；不填则用脚本所在目录
MCP_SERVER_CWD=
